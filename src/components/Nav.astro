---
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: "Work", href: "/gallery" },
  { label: "Writing", href: "/blog" },
  { label: "About", href: "/about" },
  { label: "Music", href: "/music" },
];
---

<nav id="main-nav" transition:persist="navbar" class="nav-wrap">
  <div id="nav-shell" class="nav-bar">
    <!-- Wordmark - simple text, no box -->
    <a href="/" id="nav-logo" class="nav-wordmark focus-ring">
      Josh Elland
    </a>

    <!-- Desktop Links - simple horizontal list -->
    <div class="nav-links" id="nav-links-desktop">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "nav-link focus-ring",
            (currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)))
              && "is-active",
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="nav-burger focus-ring"
      aria-label="Menu"
    >
      <span id="burger-1"></span>
      <span id="burger-2"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="nav-mobile-menu">
    {navLinks.map((link, i) => (
      <a
        href={link.href}
        class:list={[
          "nav-mobile-link",
          (currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)))
            && "is-active",
        ]}
        style={`--i: ${i}`}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const burger1 = document.getElementById("burger-1");
  const burger2 = document.getElementById("burger-2");
  const nav = document.getElementById("main-nav");

  let isOpen = false;

  const isTransparentNavPage = () => document.body.dataset.transparentNav === "true";

  const syncNavState = () => {
    if (!nav) return;
    const scrolled = window.scrollY > 40;
    nav.classList.toggle("is-scrolled", scrolled);
  };

  btn?.addEventListener("click", () => {
    isOpen = !isOpen;
    menu?.classList.toggle("is-open", isOpen);
    btn?.classList.toggle("is-open", isOpen);
  });

  window.addEventListener("scroll", syncNavState, { passive: true });

  document.addEventListener('astro:page-load', () => {
    const currentPath = window.location.pathname;
    const desktopLinks = document.querySelectorAll('#nav-links-desktop a');
    const mobileLinks = document.querySelectorAll('#mobile-menu a');
    
    const updateLinks = (links: NodeListOf<Element>) => {
      links.forEach(link => {
        const href = link.getAttribute('href');
        if (!href) return;
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        link.classList.toggle('is-active', isActive);
      });
    };
    
    updateLinks(desktopLinks);
    updateLinks(mobileLinks);

    if (isOpen && btn && menu) {
      isOpen = false;
      menu.classList.remove("is-open");
      btn.classList.remove("is-open");
    }

    syncNavState();
  });

  syncNavState();
</script>
